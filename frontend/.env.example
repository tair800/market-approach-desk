# Base URL of the market-approach-desk API, without a trailing slash.
#
# Server-side only. It is read exclusively by the route handlers under `app/api/console/`, is never
# prefixed with NEXT_PUBLIC_, and must never be added to `next.config.ts` under `env` — either would
# inline it into the browser bundle.
APPROACH_API_BASE_URL=http://localhost:8000
