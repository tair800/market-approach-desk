# Copy to .env for local work. Every value here is a placeholder; none is a credential.

# The database. `mad_local_dev` is the Compose stack's password, on a localhost-bound container
# holding invented data. It is not reachable from anywhere else and must never be reused.
MAD_POSTGRES_DSN=postgresql://mad:mad_local_dev@localhost:15433/mad

# local | ci | staging | production. `production` suppresses the interactive API browser.
MAD_ENVIRONMENT=local

# Publishes the demonstration controls, which seed and reset data. Never true in production.
MAD_DEMO_MODE=false

# Fail-closed. Empty means no browser origin may call the API directly; the console reaches it
# server-side and needs none.
MAD_CORS_ALLOW_ORIGINS=[]

# --- Reply classification (M6) ------------------------------------------------------------
# Names only. The shipped package ships no HTTP client and cannot dial a provider; the live
# transport lives under tests/ and is reached only through an explicit opt-in.
# MAD_LIVE_CLASSIFY=1
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_MODEL=some/alias
# LLM_API_KEY=
